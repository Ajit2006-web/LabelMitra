# LabelMitra - Environment Configuration Template
# Duplicate this file to .env and configure the secrets appropriately.

# Node Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labelmitra?schema=public"

# JWT Authentication Secret and Expiry
JWT_SECRET="labelmitra_dev_jwt_secret_key_change_in_production_min32chars"
JWT_EXPIRES_IN="7d"

# Python AI Microservice URL (PaddleOCR, Image Preprocessing)
AI_SERVICE_URL="http://localhost:8000"

# LLM Configuration (Configurable via environment variables - Gemini, OpenAI, etc.)
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Embeddings & Vector Search (pgvector / SentenceTransformers)
EMBEDDING_MODEL="all-MiniLM-L6-v2"
