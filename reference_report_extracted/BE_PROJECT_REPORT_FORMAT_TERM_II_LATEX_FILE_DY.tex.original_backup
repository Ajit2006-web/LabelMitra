\section{Methodologies/Algorithm Details}

\subsection{Algorithm 1/Pseudo Code: Idempotent Webhook Intake \& Durable Queueing}
\begin{lstlisting}[caption={Algorithm 1: Atomic Duplicate Check and Durable Event Enqueue (Node.js + Redis + RabbitMQ)}]
ALGORITHM: IdempotentWebhookIntake(Request req)
INPUT: Webhook HTTP Request req containing EventEnvelope e
OUTPUT: HTTP Status Response (200 OK or 400 Bad Request)

1. Verify HMAC signature and required fields (e.event_id, e.sku_id, e.channel, e.delta_qty)
2. IF payload is invalid THEN
3.     RETURN HTTP 400 ("Invalid Event Schema")
4. END IF
5. dedup_key <- "idemp:" + e.channel + ":" + e.event_id
6. is_new <- Redis.SET(dedup_key, e.occurred_at, NX=True, EX=86400)
7. IF is_new == FALSE THEN
8.     LogInfo("Duplicate webhook ignored safely: " + e.event_id)
9.     RETURN HTTP 200 ("ACK_DUPLICATE_IGNORED")
10. END IF
11. Publish e to RabbitMQ durable queue "inventory.events" with delivery_mode = PERSISTENT (2)
12. Wait for RabbitMQ Publisher Confirm
13. RETURN HTTP 200 ("ACK_ENQUEUED")
\end{lstlisting}

\subsection{Algorithm 2/Pseudo Code: Event-Sourced Stock Fold, Priority Conflict Resolution \& Human-Approved Recommendation Loop}
\begin{lstlisting}[caption={Algorithm 2: Priority Conflict Resolution and Evidence-Based Buffer Advisor (Python + PostgreSQL)}]
ALGORITHM: ProcessInventoryEventAndResolveConflict(EventEnvelope e)
INPUT: Persisted EventEnvelope e consumed from RabbitMQ
OUTPUT: Updated Stock Projection, Conflict Resolution Action, and Optional Buffer Recommendation

1. BEGIN PostgreSQL SERIALIZABLE / Row-Locked Transaction for e.sku_id:
2. INSERT e INTO inventory_events (event_id, sku_id, channel, event_type, delta_qty, net_margin, ...)
3. current_stock <- SELECT COALESCE(SUM(delta_qty), 0) FROM inventory_events WHERE sku_id = e.sku_id
4. IF current_stock >= 0 THEN
5.     UPDATE sku_projections SET physical_stock = current_stock WHERE sku_id = e.sku_id
6.     COMMIT Transaction
7.     BroadcastUpdatedStockToChannels(e.sku_id, current_stock)
8. ELSE
9.     // Conflict Detected: Concurrent sales pushed stock below zero!
10.    contending_orders <- FetchConcurrentOrdersInRaceWindow(e.sku_id, window_ms=2000)
11.    FOR EACH order o IN contending_orders DO
12.        o.priority_score <- (w1 * NormalizeMargin(o.net_margin))
                               + (w2 * o.customer_tier_score)
                               + (w3 * ChannelSLAPenalty(o.channel))
13.    END FOR
14.    order_to_unwind <- ARGMIN(o.priority_score FOR o IN contending_orders)
15.    comp_event <- CreateCompensatingUnwindEvent(order_to_unwind, delta_qty = + abs(order_to_unwind.qty))
16.    INSERT comp_event INTO inventory_events
17.    reconciled_stock <- current_stock + comp_event.delta_qty
18.    INSERT conflict record INTO conflict_audit_log WITH full explanation & margin_saved
19.     TriggerImmediateCustomerRefundAndApology(order_to_unwind)
20.    // Self-Improving Human-in-the-Loop Recommendation Check:
21.    monthly_conflicts <- CountMonthlyConflicts(e.sku_id, order_to_unwind.channel)
22.    IF monthly_conflicts >= CONFLICT_THRESHOLD THEN
23.        suggested_buffer <- CalculateOptimalBuffer(e.sku_id, order_to_unwind.channel)
24.        INSERT INTO buffer_recommendations (sku_id, target_channel, suggested_buffer, status='PENDING_HUMAN_APPROVAL')
25.    END IF
26.    COMMIT Transaction
27. END IF
28. RabbitMQ.basic_ack(e.delivery_tag)
\end{lstlisting}

